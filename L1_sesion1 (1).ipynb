        "assert not es_primo(0) and not es_primo(1) and not es_primo(91) and not es_primo(1000001)\n",
        "print(\"✔ es_primo pasa las pruebas.\")\n",
        "print(\"¿1679 es primo?\", es_primo(1679))"
      ]
